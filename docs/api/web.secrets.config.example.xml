<?xml version="1.0" encoding="utf-8"?>
<!-- ĐỔI TÊN file này thành web.secrets.config và điền giá trị thật.
     File web.secrets.config nằm trong .gitignore — không đẩy lên Git.

     Gmail: bật 2FA → tạo App Password tại
     https://myaccount.google.com/apppasswords
     rồi điền vào SMTP_PASS (16 ký tự). -->
<appSettings>
  <add key="GROQ_API_KEY" value="gsk_YOUR_KEY_HERE" />

  <!-- Góp ý → email -->
  <add key="FEEDBACK_TO" value="onetools27@gmail.com" />
  <add key="SMTP_HOST" value="smtp.gmail.com" />
  <add key="SMTP_PORT" value="587" />
  <add key="SMTP_USER" value="onetools27@gmail.com" />
  <add key="SMTP_PASS" value="YOUR_GMAIL_APP_PASSWORD" />
  <add key="SMTP_FROM" value="onetools27@gmail.com" />

  <!-- Tuỳ chọn: URL Google Apps Script (api/feedback-mail.gs) — ổn định hơn FormSubmit -->
  <add key="FEEDBACK_WEBHOOK" value="" />
</appSettings>
